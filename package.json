{
  "name": "fab",
  "homepage": "https://LaSarsoJackson.github.io/fab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "maplibre-gl": "^6.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build:tour-data": "bun run scripts/generate-tour-biography-aliases.js",
    "build:data": "bun run build:tour-data && bun run scripts/precalculate-metadata.js",
    "build": "bash ./scripts/build-production.sh",
    "preview": "vite preview --host 0.0.0.0",
    "doctor": "bash ./scripts/dev-doctor.sh",
    "lint": "eslint . && oxlint .",
    "check": "bun run doctor && bun run lint && bun run release:check && bun run test && bun run build",
    "release:check": "bun run scripts/check-release-metadata.js",
    "test": "bun run test:unit && bun run test:dom",
    "test:unit": "find src test -type f -name '*.test.js' -print0 | xargs -0 bun test",
    "test:dom": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --config vitest.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "oxlint": "1.79.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.8"
}
